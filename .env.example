# Copy this file to .env and fill in your real values. Never commit the real .env file.

# Your Paystack secret key (test or live) — found in Paystack Dashboard > Settings > API Keys & Webhooks.
# Without this set, MoMo payments run in SIMULATED mode (safe for local development).
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Comma-separated list of domains allowed to connect (CORS). Leave unset for local/demo
# use — the server will warn on startup and default to wide-open ("*"), which is fine
# until you deploy this somewhere with real users.
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
